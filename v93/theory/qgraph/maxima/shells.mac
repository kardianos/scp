/* shells.mac -- shells as Laplacian degeneracy classes; neutrality of a
   CLOSED shell; charge as the circulation an INCOMPLETE shell cannot cancel.

   Setting: the ring C_N (the programme's own C6 retention object).
     modes     chi_m(j) = e^(2 pi i m j / N)/sqrt(N),   m in Z_N
     spectrum  lambda_m = 2(1 - cos(2 pi m / N)) = 4 sin^2(pi m / N)
     link current of a single mode:
        circ_m ~ Im( sum_j conj(chi_m(j)) chi_m(j+1) ) = sin(2 pi m / N)

   S1  lambda_m = lambda_(N-m): shells are the +-m DOUBLETS plus the
       m=0 (and, for even N, m=N/2) SINGLETS.  c_k = dim eigenspace.
   S2  circ_m + circ_(N-m) = 0 identically: a FULL shell is NEUTRAL.
   S2b circ_0 = circ_(N/2) = 0: both singlets are neutral (the zone-
       boundary mode is real/self-conjugate -- standing, not circulating).
   S3  a HALF-FILLED doublet keeps circ = +-sin(2 pi m/N) != 0: CHARGE.
   S4  magic numbers Z_j = sum_{k<=j} c_k are the only neutral totals
       -> mass quantization (monodispersity).

   Run:  maxima --very-quiet -b shells.mac < /dev/null                  */

ratprint : false$
declare(t, real)$

/* work in the reduced angle t = 2 pi m / N so the identities are exact */
lamt(t)  := 2*(1 - cos(t))$
circt(t) := sin(t)$

print("=== S1: degeneracy.  m <-> N-m  means  t <-> 2*pi - t ===")$
print("  lambda(t) - lambda(2*pi - t) =",
      trigsimp( trigexpand( lamt(t) - lamt(2*%pi - t) ) ),
      "   (0 => the eigenspace is 2-dimensional)")$
print("  closed form check, lambda(t) - 4 sin^2(t/2) =",
      trigsimp( trigreduce( lamt(t) - 4*sin(t/2)^2 ) ))$

print("=== S2: a FULL doublet carries NO net circulation ===")$
print("  circ(t) + circ(2*pi - t) =",
      trigsimp( trigexpand( circt(t) + circt(2*%pi - t) ) ),
      "   (0 => CLOSED SHELL IS NEUTRAL, identically, for every m and N)")$

print("=== S2b: both singlets are neutral ===")$
print("  circ(0)  =", circt(0), "     (m = 0: uniform mode, no current)")$
print("  circ(pi) =", circt(%pi), "     (m = N/2: real standing mode, no current)")$

print("=== S3: an INCOMPLETE doublet is charged ===")$
print("  occupying only +m leaves circ = sin(2*pi*m/N), e.g. N=6:")$
for m: 1 thru 2 do
  print("      m =", m, "  circ =", trigsimp(circt(2*%pi*m/6)),
        " =", float(ev(circt(2*%pi*m/6), numer)))$
print("  ==> CHARGE = the residual circulation of an unclosed harmonic shell.")$
print("      Its integer label is the winding m; its sign is the sense of")$
print("      circulation.  No U(1) field was imported: this is graph symmetry.")$

print("=== S4: magic numbers Z_j (the only neutral totals) ===")$
for N: 4 thru 14 do block([Z : 0, out : []],
  for k: 0 thru floor(N/2) do block([c : 0],
    for m: 0 thru N-1 do if min(m, N-m) = k then c : c + 1,
    if c > 0 then (Z : Z + c, out : endcons(Z, out))),
  print("  C_", N, "  capacities close at Z_j =", out))$
print("  ==> ring aufbau is 1, 3, 5, 7, ... (singlet, then doublets):")$
print("      one 's', then a ladder of 'p'-like counter-rotating pairs,")$
print("      derived from the graph's automorphism group, not assumed.")$
print("  ==> N (quantum count) is conserved by promotions; Z is a SPECTRAL")$
print("      invariant of the contact graph; therefore  Q = Z - N  is")$
print("      conserved by every emission/absorption event.")$
