/* v100 phase 0 — scaling algebra for E = λ E2 + E4/λ.
   Does not construct a profile. Run:
   maxima --very-quiet -b v100/phase0/cas/virial.mac < /dev/null
*/
E(lam) := lam*E2 + E4/lam;
ratio(lam) := E(lam)/E(1);
dEdlam: diff(E(lam), lam);
print("dE/dlam =", factor(dEdlam));
print("critical at lam=1 <=>", factor(subst(lam=1, dEdlam)), "= 0");
print("ratio(2) at E2=E4:", factor(subst(E2=E4, ratio(2))));
print("ratio(1/2) at E2=E4:", factor(subst(E2=E4, ratio(1/2))));
quit();
