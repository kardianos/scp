  n = 8   E = 12.6863   E_w = 4.68629   E_s = 8 
  n = 9   E = 13.2112   E_w = 4.2112   E_s = 9 
  n = 10   E = 13.8197   E_w = 3.81966   E_s = 10 
  n = 11   E = 14.4924   E_w = 3.49242   E_s = 11 
  n = 12   E = 15.2154   E_w = 3.21539   E_s = 12 
print("=== W6: no half-winding on C_n ===")
=== W6: no half-winding on C_n === 
print("  W must be integer or ψ is not single-valued on the cycle.")
  W must be integer or ψ is not single-valued on the cycle. 
