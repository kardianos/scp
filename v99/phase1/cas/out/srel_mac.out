print("=== I5: integer argmin of E_w/ε + n ===")
=== I5: integer argmin of E_w/ε + n === 
vals5:map(lambda([n],float(Ew(n)/eps(n)+n)),ns)
be5:apply(min,vals5)
best5:[]
for i thru length(ns) do
    if abs(vals5[i]-be5) < 1.0E-9 then best5:endcons(ns[i],best5)
print("  min=",be5,"  n*=",best5)
  min= 35.648389   n*= [3] 
