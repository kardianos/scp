print("=== I3: E_w/ε = 4 π n sin(π/n) is increasing ===")
=== I3: E_w/ε = 4 π n sin(π/n) is increasing === 
print("  n=3:",float(4*%pi*3*sin(%pi/3)),"  n→∞:",float(4*%pi*%pi))
  n=3: 32.648389   n→∞: 39.478418 
print("=== I4: integer argmin of E_w + n ε, n=3..24 ===")
=== I4: integer argmin of E_w + n ε, n=3..24 === 
ns:makelist(n,n,3,24)
vals4:map(lambda([n],float(Ew(n)+n*eps(n))),ns)
be4:apply(min,vals4)
best4:[]
for i thru length(ns) do
    if abs(vals4[i]-be4) < 1.0E-9 then best4:endcons(ns[i],best4)
print("  min=",be4,"  n*=",best4)
  min= 2.632707   n*= [24] 
for n from 3 thru 12 do print("    n=",n,"  E_w+nε=",float(Ew(n)+n*eps(n)))
    n= 3   E_w+nε= 9.8269933 
