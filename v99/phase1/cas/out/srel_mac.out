
batch("/home/d/code/scp/v99/phase1/cas/srel.mac")
ratprint:false
fpprintprec:8
Ew(n):=4*n*sin(%pi/n)^2
om(n):=2*sin(%pi/n)
eps(n):=om(n)/(2*%pi)
print("=== I1/I2/I3: closed forms at n=3,4,6,8,12,24 ===")
=== I1/I2/I3: closed forms at n=3,4,6,8,12,24 === 
for n in [3,4,6,8,12,24] do
    print("  n=",n,"  E_w=",float(Ew(n)),"  ω=",float(om(n)),"  ε=",
          float(eps(n)),"  nε=",float(n*eps(n)),"  E_w/ε=",
          float(Ew(n)/eps(n)))
  n= 3   E_w= 9.0   ω= 1.7320508   ε= 0.27566445   nε= 0.82699334   E_w/ε= 
                                                                     32.648389 
