/* charge_sym.mac — symbolic charge construction (O3') in maxima.        */
/* Subordinate to CHARGE.md §7. Verifies the load-bearing §7.2 claims and */
/* derives the general N-cycle monodromy + mass-size-charge relation.     */
/* Run: maxima -b charge_sym.mac                                         */

/* ===================================================================== */
/* PART 1 — the kink core energy I(p) [CHARGE §7.2: E_core = sqrt(2A)*I(p)/Q] */
/* The standing gate potential V(psi,p) = 1 - ((1+cos psi)/2)^p_gate.    */
/* Bogomolny first-integral of the FK chain: the static kink (charge)    */
/* energy is the integral of sqrt(V) across the 2pi twist.               */
/* ===================================================================== */

V(psi,p) := 1 - ((1+cos(psi))/2)^p;

/* I(p) = int_0^2pi sqrt(V(psi,p)) dpsi  — the shape factor of the core. */
Inum(p) := quad_qags(sqrt(V(psi,p)), psi, 0, 2*%pi)[1];

print("=== PART 1: kink core energy I(p) ===")$
print("I(1)  [sine-Gordon check, claimed 4.0000] = ", float(Inum(1)))$
print("I(2)                                  = ", float(Inum(2)))$
print("I(4)                                  = ", float(Inum(4)))$
print("I(8)  [standing p_gate, claimed 5.405] = ", float(Inum(8)))$
print("I(16)                                 = ", float(Inum(16)))$

/* The p=1 exact value (sine-Gordon / FK Bogomolny). */
I1 : integrate(sqrt(1-(1+cos(psi))/2),psi);   /* antiderivative (symbolic) */
print("p=1 antiderivative: ", I1)$
print("p=1 exact 0->2pi: ", ev(I1,psi=2*%pi)-ev(I1,psi=0))$

/* Max gate torque (CHARGE §7.2: claimed 1.233*eps at psi=0.505, p=8).   */
/* torque = -dV/dpsi. Find argmax |dV/dpsi| for p=8.                      */
dV(psi,p) := diff(V(psi,p),psi);
print("--- max |torque| for p=8 ---")$
torque8(psi) := ''(ratsimp(diff(V(psi,8),psi)));
/* numerically locate the max of |torque| in (0,pi) */
m  : qags(torque8(psi)^2, psi, 1e-3, %pi-1e-3);
print("integral of torque^2 (proxy): ", float(m[1]))$
/* scan for the argmax */
print("torque at psi=0.505 (p=8): ", float(torque8(0.505)))$
print("torque at psi=0.5,p=8: ", float(torque8(0.5)))$

/* ===================================================================== */
/* PART 2 — the general N-cycle monodromy: charge = k/Q                  */
/* (CHARGE §7.1, generalized beyond the third-harmonic triangle.)        */
/*                                                                       */
/* An interval edge l carries a p_l:q_l lock:  q_l*theta_{l+1} - p_l*theta_l = alpha_l + 2*pi*n_l   */
/*   -> theta_{l+1} = (p_l*theta_l + alpha_l + 2*pi*n_l)/q_l            */
/* Composing around a cycle of N edges gives the monodromy M(theta_0)=theta_N. */
/* Frequency closure: prod(p_l/q_l) = 1  <=>  prod p_l = prod q_l = Q*... */
/* Under closure the monodromy is theta_N = theta_0 + (continuous comma) + 2*pi*k/Q.  */
/* CHARGE := k/Q.                                                        */
/* ===================================================================== */

print("")$
print("=== PART 2: N-cycle monodromy -> charge = k/Q ===")$

/* Build the monodromy symbolically for an N-cycle with lists p,q,alpha. */
/* Each edge map: theta_out = (p*theta_in + alpha + 2*pi*n)/q.           */
/* Compose linearly in (theta, offset) coordinates: theta -> (P/Q)*theta + c */
monodromy(pl,ql,al,nl) := block(
  [P:1, Q:1, c:0, theta:theta0],
  /* iterate: after l edges, theta = (P/Q)*theta0 + c, with branches summing */
  for l:1 thru length(pl) do (
    P : P*pl[l],
    Q : Q*ql[l],
    /* the running offset accumulates the alpha and branch contributions,
       each divided by the product of q's encountered so far */
    c : (c + al[l] + 2*%pi*nl[l])/ql[l]
  ),
  /* after the full cycle: theta_N = (P/Q)*theta0 + c */
  [P, Q, c]
)$

/* Triangle {3:1, 1:3, 1:1} — the §7.1 case. Closure: 3*1*1 / (1*3*1) = 1. */
m_tri : monodromy([3,1,1],[1,3,1],[a1,a2,a3],[n1,n2,n3]);
print("triangle {3:1,1:3,1:1}: P,Q,c = ", m_tri)$
print("  P/Q = ", ratsimp(m_tri[1]/m_tri[2]), " (closure => 1)")$
print("  c   = ", ratsimp(m_tri[3]))$
print("  monodromy offset mod 2pi = ", ratsimp(trigreduce(m_tri[3])))$
print("  -> discrete branch 2*pi*n1*n2*n3 / 3 = 2*pi*k/3 ; charge = k/3")$

/* General rule: under closure P=Q, the branch part is 2*pi*k/Q with Q=prod(q_l). */
print("--- general: Q = prod(q_l); branch = 2*pi*k/Q; charge = k/Q ---")$

/* Additivity over composites (E1/E2): two cycles of Q1,Q2 joined -> Q = lcm or prod */
print("composite charge additivity: k1/Q1 + k2/Q2 = (k1*Q2 + k2*Q1)/(Q1*Q2) -> integer-gcd reduces")$

/* ===================================================================== */
/* PART 3 — confinement (E2): only integer holonomy transports through unison (Q=1) */
/* A fractional slip k/Q in a unison medium (Q=1) would need to re-derive */
/* through the gate desert. Symbolically: a unison edge is p=q=1, so any   */
/* branch n is a full 2pi (integer) — fractions cannot be carried.        */
/* ===================================================================== */
print("")$
print("=== PART 3: confinement ===")$
print("unison edge: p=q=1 -> branch step = 2pi*n (integer only).")$
print("=> fractional k/Q cannot traverse a unison medium; confined to interval-rich cycles.")$

/* ===================================================================== */
/* PART 4 — the MASS-SIZE-CHARGE relation (the user's thesis).           */
/* A charge-carrying cycle of N edges, interval cover Q, trapped winding k: */
/*   M(N,Q,k) = N*e_balance(L)  +  (k/Q)*E_core(p)  +  (k/Q)^2 * E_dress  */
/* where:                                                                */
/*   e_balance(L) = dense balance energy per voice at loop size L         */
/*   E_core(p)    = sqrt(2A)*I(p)           [PART 1]                     */
/*   E_dress      ~ q^2 * (far gradient energy)  [needs EM5 cone for 1/r] */
/*                                                                       */
/* SIZE CONDITION for charge formation: the kink is stable on the cycle   */
/* only if its core fits: core width xi ~ sqrt(A/V'') < N (cycle perimeter)*/
/* and the Peierls-Nabarro barrier exceeds thermal/transport noise.       */
/* Discrete allowed (N,Q,k): closure + size + balance simultaneously.     */
/* ===================================================================== */
print("")$
print("=== PART 4: mass-size-charge relation ===")$
print("M(N,Q,k) = N*e_balance(L) + (k/Q)*sqrt(2A)*I(p) + (k/Q)^2*E_dress")$
print("size condition: kink core width xi=sqrt(A/V''(0)) must fit the cycle: N*d > k*xi")$

/* V''(0) for the gate potential (curvature at the minimum psi=0). */
Vdd(p) := ''(ratsimp(subst(psi=0,diff(V(psi,p),psi,2))));
print("V''(0) general: ", Vdd(p))$
print("V''(0) at p=8: ", float(ev(Vdd(8))))$
/* kink core width xi = sqrt(2A / V''(0)) in the continuum limit */
print("kink width xi(p=8) ~ sqrt(2A/V''(0)) = sqrt(2A/",float(ev(Vdd(8))),")")$

/* ===================================================================== */
/* PART 5 — the electron (CHARGE §7.3): the dressed delocalized kink.    */
/* No dense core (no closed cycle): E_balance = 0, E_core -> 0 (delocalized). */
/* Mass = E_dress (field-gradient scale) only -> naturally light.         */
/* Its substance is the slip + the far phase dressing (O1's texture).     */
/* ===================================================================== */
print("")$
print("=== PART 5: electron = unbound field harmonic (dressed delocalized kink) ===")$
print("M_e = E_dress (no dense core, no closed cycle) -> field-gradient scale, light.")$
print("localizes only at conversion events (the measured Tonomura click machinery).")$

print("")$
print("=== charge_sym.mac DONE ===")$
